# Optional cloud sync (Supabase). Absent → the app runs fully local (IndexedDB only).
# Copy to `.env` and fill with the SAME values your web app uses so web + desktop
# share one backend. Read at build time by Vite (including the Tauri desktop build).
# See docs/SUPABASE_SETUP.md.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...your-anon-public-key...
